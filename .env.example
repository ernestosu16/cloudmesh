# Copiar a .env para desarrollo local. En Dokploy se definen en la pestaña Environment.

# Dirección de escucha del servidor HTTP.
CLOUDMESH_ADDR=:8080

# Carpeta con la base SQLite y datos persistentes. En Docker es el volumen /data.
CLOUDMESH_DATA_DIR=./data

# Clave maestra para cifrar credenciales de proveedores (32 bytes en base64).
# Generar con: openssl rand -base64 32
CLOUDMESH_MASTER_KEY=

# Secreto para firmar cookies de sesión (32 bytes en base64).
# Generar con: openssl rand -base64 32
CLOUDMESH_SESSION_SECRET=

# Tamaño máximo por archivo subido, en bytes (defecto 5 GiB).
CLOUDMESH_MAX_UPLOAD_BYTES=5368709120

# Subidas y descargas simultáneas por proceso (cada una retiene una franja k×bloque en memoria).
CLOUDMESH_MAX_UPLOADS=4
CLOUDMESH_MAX_DOWNLOADS=8

# 1 detrás de un proxy inverso (Traefik de Dokploy): usa X-Forwarded-For y X-Forwarded-Proto.
CLOUDMESH_TRUST_PROXY=0

# API compatible con S3 (estilo Cloudflare R2). «off» la desactiva.
CLOUDMESH_S3_ADDR=:9000
# URL pública de la API S3 (p. ej. https://s3.tudominio). Se muestra en la app y
# su host activa también el estilo virtual-host (<bucket>.s3.tudominio) si un DNS
# comodín *.s3.tudominio apunta al servidor. Vacía: solo estilo de ruta.
CLOUDMESH_S3_URL=
# Región que se anuncia; como en R2, «auto».
CLOUDMESH_S3_REGION=auto

# Correo para las invitaciones: smtp://usuario:clave@host:587 (STARTTLS) o
# smtps://usuario:clave@host:465. Vacío: el enlace de invitación se copia a mano.
CLOUDMESH_SMTP_URL=
# Remitente; por defecto el usuario de la URL. P. ej. CloudMesh <cloudmesh@tudominio>
CLOUDMESH_SMTP_FROM=

# Nivel de log: debug | info | warn | error
CLOUDMESH_LOG_LEVEL=info

# Solo desarrollo con docker compose: puertos publicados en el host si 8080/5173 están ocupados.
CLOUDMESH_API_PORT=8080
CLOUDMESH_WEB_PORT=5173
CLOUDMESH_S3_PORT=9000
